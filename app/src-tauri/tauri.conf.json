{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeSeries",
  "version": "0.3.0",
  "identifier": "dev.freeseries.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreeSeries",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#1E1E1E",
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/setup.ps1",
      "resources/fxvad/*"
    ],
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
